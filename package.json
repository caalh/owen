{
  "name": "owen-neutronics",
  "displayName": "OWEN — Open Workspace for Engineered Neutronics",
  "description": "Nuclear reactor modeling toolkit for MCNP, OpenMC, Serpent, SCONE, and PHITS: a Monte Carlo language server with real-time physics-aware diagnostics, OpenMC XML validation, full-core 3D geometry preview, native OpenMC rendering and geometry verification, cross-code deck converters (MCNP↔OpenMC stable, plus the official openmc_mcnp_adapter as an optional backend), results viewer (k-eff, spectra, mesh heatmaps), parametric sweep dashboard, lattice and input builders with the 411-material PNNL-15870 compendium, and the ALLEN σ(E) explorer with Doppler Studio.",
  "version": "1.1.5",
  "publisher": "belvoirdynamics",
  "author": "Aaron W. Calhoun",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "assets/owen-icon.png",
  "homepage": "https://reactormc.net",
  "bugs": {
    "url": "https://github.com/caalh/owen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caalh/owen.git"
  },
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "keywords": [
    "mcnp",
    "openmc",
    "serpent",
    "scone",
    "phits",
    "nuclear",
    "monte-carlo",
    "reactor",
    "neutronics",
    "lattice",
    "language-server",
    "3d",
    "pnnl",
    "cross-sections",
    "k-eff",
    "criticality",
    "beavrs"
  ],
  "activationEvents": [
    "onLanguage:mcnp",
    "onLanguage:serpent",
    "onLanguage:scone",
    "onLanguage:python",
    "onCommand:owen.openLatticeBuilder",
    "onCommand:owen.openInputBuilder",
    "onCommand:owen.openAllen",
    "onCommand:owen.openResults",
    "onCommand:owen.validateInput",
    "onCommand:owen.runSimulation",
    "onCommand:owen.openGeometryPreview",
    "onCommand:owen.renderWithOpenmc",
    "onCommand:owen.verifyGeometry",
    "onCommand:owen.searchReactorLibrary",
    "onCommand:owen.openCommunityLibrary",
    "onCommand:owen.openPrebuiltModel",
    "onCommand:owen.insertMaterial",
    "onCommand:owen.openTutorial",
    "onCommand:owen.runSweep",
    "onCommand:owen.viewSweepResults",
    "onCommand:owen.convertDeck",
    "onCommand:owen.convertDeckAdapter",
    "onCommand:owen.chooseHighlightPalette",
    "onCommand:owen.toggleInvisibleCharacters",
    "onCommand:owen.showMcnpReferences",
    "onCommand:owen.setMcnpProjectRoot",
    "onView:owenMcnpReferences",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[mcnp]": {
        "editor.occurrencesHighlight": "singleFile",
        "editor.selectionHighlight": false
      }
    },
    "languages": [
      {
        "id": "mcnp",
        "aliases": [
          "MCNP",
          "mcnp"
        ],
        "extensions": [
          ".i",
          ".mcnp",
          ".inp"
        ],
        "configuration": "./language-configuration/mcnp.language-configuration.json"
      },
      {
        "id": "serpent",
        "aliases": [
          "Serpent",
          "serpent"
        ],
        "extensions": [
          ".serp"
        ],
        "configuration": "./language-configuration/serpent.language-configuration.json"
      },
      {
        "id": "scone",
        "aliases": [
          "SCONE",
          "scone"
        ],
        "extensions": [
          ".scone"
        ],
        "configuration": "./language-configuration/scone.language-configuration.json"
      },
      {
        "id": "phits",
        "aliases": [
          "PHITS",
          "phits"
        ],
        "extensions": [
          ".phits"
        ],
        "filenames": [
          "phits.inp"
        ],
        "configuration": "./language-configuration/phits.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mcnp",
        "scopeName": "source.mcnp",
        "path": "./syntaxes/mcnp.tmLanguage.json"
      },
      {
        "language": "serpent",
        "scopeName": "source.serpent",
        "path": "./syntaxes/serpent.tmLanguage.json"
      },
      {
        "language": "scone",
        "scopeName": "source.scone",
        "path": "./syntaxes/scone.tmLanguage.json"
      },
      {
        "language": "phits",
        "scopeName": "source.phits",
        "path": "./syntaxes/phits.tmLanguage.json"
      },
      {
        "scopeName": "openmc.injection",
        "path": "./syntaxes/openmc.injection.tmLanguage.json",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "commands": [
      {
        "command": "owen.openAllen",
        "title": "OWEN: Open ALLEN Cross-Sections",
        "category": "OWEN",
        "icon": "$(graph-line)"
      },
      {
        "command": "owen.openResults",
        "title": "OWEN: View Results",
        "category": "OWEN",
        "icon": "$(output)"
      },
      {
        "command": "owen.openLatticeBuilder",
        "title": "OWEN: Open Input Builder (Lattice tab)",
        "category": "OWEN"
      },
      {
        "command": "owen.openInputBuilder",
        "title": "OWEN: Open Input Builder",
        "category": "OWEN"
      },
      {
        "command": "owen.validateInput",
        "title": "OWEN: Validate Input File",
        "category": "OWEN"
      },
      {
        "command": "owen.runSimulation",
        "title": "OWEN: Run Simulation",
        "category": "OWEN"
      },
      {
        "command": "owen.openGeometryPreview",
        "title": "OWEN: Open 3D Geometry Preview",
        "category": "OWEN"
      },
      {
        "command": "owen.renderWithOpenmc",
        "title": "OWEN: Render with OpenMC (authoritative)",
        "category": "OWEN",
        "icon": "$(symbol-color)"
      },
      {
        "command": "owen.verifyGeometry",
        "title": "OWEN: Verify Geometry with OpenMC",
        "category": "OWEN",
        "icon": "$(check)"
      },
      {
        "command": "owen.searchReactorLibrary",
        "title": "OWEN: Search Reactor Library",
        "category": "OWEN"
      },
      {
        "command": "owen.openCommunityLibrary",
        "title": "OWEN: Open Community Library on reactormc.net",
        "category": "OWEN",
        "icon": "$(link-external)"
      },
      {
        "command": "owen.openPrebuiltModel",
        "title": "OWEN: Open Prebuilt Model…",
        "category": "OWEN"
      },
      {
        "command": "owen.insertMaterial",
        "title": "OWEN: Insert Material from Database",
        "category": "OWEN"
      },
      {
        "command": "owen.openTutorial",
        "title": "OWEN: Search ReactorMC (Tutorials & NRDP)",
        "category": "OWEN"
      },
      {
        "command": "owen.runSweep",
        "title": "OWEN: Run Parameter Sweep",
        "category": "OWEN"
      },
      {
        "command": "owen.viewSweepResults",
        "title": "OWEN: View Sweep Results (Dashboard)",
        "category": "OWEN",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "owen.convertDeck",
        "title": "OWEN: Convert Deck… (MCNP↔OpenMC)",
        "category": "OWEN",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "owen.convertDeckAdapter",
        "title": "OWEN: Convert to OpenMC XML (openmc adapters)",
        "category": "OWEN",
        "icon": "$(arrow-right)"
      },
      {
        "command": "owen.chooseHighlightPalette",
        "title": "OWEN: Choose Highlight Palette",
        "category": "OWEN"
      },
      {
        "command": "owen.toggleInvisibleCharacters",
        "title": "OWEN: Toggle Invisible Characters",
        "category": "OWEN"
      },
      {
        "command": "owen.showMcnpReferences",
        "title": "OWEN: Show MCNP References (Cross-Reference Tracker)",
        "category": "OWEN",
        "icon": "$(references)"
      },
      {
        "command": "owen.setMcnpProjectRoot",
        "title": "OWEN: Set MCNP Project Root",
        "category": "OWEN"
      }
    ],
    "keybindings": [
      {
        "command": "owen.openInputBuilder",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorLangId =~ /^(mcnp|serpent|scone|python)$/"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "owen",
          "title": "OWEN",
          "icon": "assets/owen-icon.png"
        }
      ]
    },
    "views": {
      "owen": [
        {
          "id": "owenMcnpReferences",
          "name": "MCNP References",
          "icon": "$(references)",
          "contextualTitle": "OWEN MCNP References"
        }
      ]
    },
    "submenus": [
      {
        "id": "owen.contextMenu",
        "label": "OWEN"
      },
      {
        "id": "owen.editorTitleMenu",
        "label": "OWEN",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "owen.editorTitleMenu",
          "group": "navigation@100",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python|phits)$/ || editorLangId == xml && resourceFilename =~ /(materials|geometry|settings|tallies|model)\\.xml$/"
        }
      ],
      "owen.editorTitleMenu": [
        {
          "command": "owen.openAllen",
          "group": "1_analyze@0"
        },
        {
          "command": "owen.validateInput",
          "group": "1_analyze@1",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.insertMaterial",
          "group": "1_analyze@2",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.openPrebuiltModel",
          "group": "1_analyze@3"
        },
        {
          "command": "owen.showMcnpReferences",
          "group": "1_analyze@4",
          "when": "editorLangId == mcnp"
        },
        {
          "command": "owen.openInputBuilder",
          "group": "2_build@0"
        },
        {
          "command": "owen.openLatticeBuilder",
          "group": "2_build@1"
        },
        {
          "command": "owen.openGeometryPreview",
          "group": "2_build@2",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.renderWithOpenmc",
          "group": "2_build@3",
          "when": "editorLangId == python"
        },
        {
          "command": "owen.verifyGeometry",
          "group": "2_build@4",
          "when": "editorLangId == python"
        },
        {
          "command": "owen.convertDeck",
          "group": "2_build@5",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.convertDeckAdapter",
          "group": "2_build@6",
          "when": "editorLangId =~ /^(mcnp|serpent)$/"
        },
        {
          "command": "owen.openResults",
          "group": "3_run@3"
        },
        {
          "command": "owen.runSimulation",
          "group": "3_run@1",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.runSweep",
          "group": "3_run@2",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.viewSweepResults",
          "group": "3_run@4"
        },
        {
          "command": "owen.toggleInvisibleCharacters",
          "group": "4_view@1"
        },
        {
          "command": "owen.chooseHighlightPalette",
          "group": "4_view@2"
        },
        {
          "command": "owen.openTutorial",
          "group": "5_help@1"
        },
        {
          "command": "owen.searchReactorLibrary",
          "group": "5_help@2"
        },
        {
          "command": "owen.openCommunityLibrary",
          "group": "5_help@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "owen.contextMenu",
          "group": "owen@1",
          "when": "editorTextFocus && (editorLangId =~ /^(mcnp|serpent|scone|python|phits)$/ || editorLangId == xml && resourceFilename =~ /(materials|geometry|settings|tallies|model)\\.xml$/)"
        }
      ],
      "owen.contextMenu": [
        {
          "command": "owen.openAllen",
          "group": "1_analyze@0"
        },
        {
          "command": "owen.validateInput",
          "group": "1_analyze@1",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.insertMaterial",
          "group": "1_analyze@2",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.openPrebuiltModel",
          "group": "1_analyze@3"
        },
        {
          "command": "owen.showMcnpReferences",
          "group": "1_analyze@4",
          "when": "editorLangId == mcnp"
        },
        {
          "command": "owen.openInputBuilder",
          "group": "2_build@0"
        },
        {
          "command": "owen.openLatticeBuilder",
          "group": "2_build@1"
        },
        {
          "command": "owen.openGeometryPreview",
          "group": "2_build@2",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.renderWithOpenmc",
          "group": "2_build@3",
          "when": "editorLangId == python"
        },
        {
          "command": "owen.verifyGeometry",
          "group": "2_build@4",
          "when": "editorLangId == python"
        },
        {
          "command": "owen.convertDeck",
          "group": "2_build@5",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.convertDeckAdapter",
          "group": "2_build@6",
          "when": "editorLangId =~ /^(mcnp|serpent)$/"
        },
        {
          "command": "owen.openResults",
          "group": "3_run@3"
        },
        {
          "command": "owen.runSimulation",
          "group": "3_run@1",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.runSweep",
          "group": "3_run@2",
          "when": "editorLangId =~ /^(mcnp|serpent|scone|python)$/"
        },
        {
          "command": "owen.viewSweepResults",
          "group": "3_run@4"
        },
        {
          "command": "owen.openTutorial",
          "group": "4_help@1"
        },
        {
          "command": "owen.searchReactorLibrary",
          "group": "4_help@2"
        },
        {
          "command": "owen.openCommunityLibrary",
          "group": "4_help@3"
        },
        {
          "command": "owen.chooseHighlightPalette",
          "group": "5_appearance@1"
        },
        {
          "command": "owen.toggleInvisibleCharacters",
