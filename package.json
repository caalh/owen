      ],
      "view/title": [
        {
          "command": "owen.showMcnpReferences",
          "when": "view == owenMcnpReferences",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "OWEN",
      "properties": {
        "owen.openmc.executable": {
          "type": "string",
          "default": "openmc",
          "description": "Path to the OpenMC executable. Used only for non-Python OpenMC entry points; Python model scripts run via 'owen.openmc.pythonExecutable'."
        },
        "owen.openmc.pythonExecutable": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter used to run OpenMC model scripts (e.g. build_model.py). When explicitly set, it is also the first candidate probed by 'OWEN: Render with OpenMC (authoritative)'; otherwise that command falls back to the ms-python interpreter, python/python3 on PATH, then WSL."
        },
        "owen.mcnp.executable": {
          "type": "string",
          "default": "mcnp6",
          "description": "Path to the MCNP executable."
        },
        "owen.mcnp.lineLengthLimit": {
          "type": "integer",
          "default": 80,
          "minimum": 1,
          "description": "MCNP card-image column limit. Lines longer than this are flagged (Problems + an in-editor decoration) because characters past the limit are silently ignored by MCNP. The classic limit is 80 columns (MCNP5 / MCNP6.1 and earlier); set to 128 for MCNP6.2+. Also drives the language-scoped ruler shown in MCNP files."
        },
        "owen.mcnp.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the MCNP project root (.inp file or directory containing the main deck). When set, OWEN validates cells/surfaces/materials/universes across read/copy includes."
        },
        "owen.mcnp.workspaceValidation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run cross-file MCNP workspace validation when owen.mcnp.projectRoot is set."
        },
        "owen.mcnp.workspaceValidation.warnUnused": {
          "type": "boolean",
          "default": false,
          "description": "Emit unused-definition hints (mcnp.unused-*) project-wide during workspace validation."
        },
        "owen.serpent.executable": {
          "type": "string",
          "default": "sss2",
          "description": "Path to the Serpent executable."
        },
        "owen.scone.executable": {
          "type": "string",
          "default": "scone",
          "description": "Path to the SCONE executable. On Windows, SCONE typically requires WSL."
        },
        "owen.simulation.workingDirectory": {
          "type": "string",
          "default": "",
          "description": "Working directory for simulation runs. Defaults to file's directory."
        },
        "owen.community.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Browse the ReactorMC Community Library from inside the editor (OWEN: Search Reactor Library). Turn this off to stop OWEN contacting reactormc.net's backend entirely; the bundled prebuilt models and snippets keep working either way."
        },
        "owen.community.webUrl": {
          "type": "string",
          "default": "https://reactormc.net/community",
          "description": "Page opened by 'OWEN: Open Community Library on reactormc.net'. Also where submissions are made — OWEN browses and inserts, but does not upload."
        },
        "owen.supabase.url": {
          "type": "string",
          "default": "https://ahalgdduwfsgfbwoxbrr.supabase.co",
          "markdownDescription": "Supabase project URL backing the Community Library. Ships pointed at the public ReactorMC project; override only to browse a different library."
        },
        "owen.supabase.anonKey": {
          "type": "string",
          "default": "sb_publishable_Kidb9yKwUxFNhbviHGte2Q_rUy3UFRc",
          "markdownDescription": "Supabase **publishable** (anon) API key for the Community Library. This is a public credential by design — Row Level Security is what protects the data, and it grants read access to approved models only. Override only alongside `#owen.supabase.url#`."
        },
        "owen.nrdp.live": {
          "type": "boolean",
          "default": true,
          "description": "Fetch NRDP data live from reactormc.net when online; falls back to bundled snapshot."
        },
        "owen.nrdp.endpoint": {
          "type": "string",
          "default": "https://reactormc.net/data",
          "description": "Base URL for live NRDP material/element snapshots (expects nrdp-materials.json and nrdp-elements.json)."
        },
        "owen.allen.dataBaseUrl": {
          "type": "string",
          "default": "https://reactormc.net/data/allen",
          "description": "Base URL for ALLEN cross-section JSON (index.json and endfb80/ curves). Override for offline or local NRDP dev servers."
        },
        "owen.preview.maxInstances": {
          "type": "integer",
          "default": 1500000,
          "minimum": 50000,
          "description": "Maximum number of cylinder instances the 3D Geometry Preview will render. The webview batches geometry into instanced meshes, so draw calls stay low regardless; this caps total instances to bound memory/CPU. When a deck's requested fidelity would exceed this, OWEN auto-simplifies detail (concentric layers → single discs, then collapses axial segments) instead of hiding pins. Raise it (e.g. 4000000) to view a full BEAVRS core at concentric-shell + axial detail on a powerful machine; lower it on constrained hardware."
        },
        "owen.highlight.mcnp.palette": {
          "type": "string",
          "enum": [
            "Classic",
            "Solarized",
            "High Contrast",
            "Pastel",
            "Custom"
          ],
          "enumDescriptions": [
            "VS Code dark default-style colors",
            "Muted Solarized-inspired accents",
            "Bright, vivid, maximum legibility",
            "Soft low-saturation tones",
            "Your own colors - edit owen.highlight.customColors"
          ],
          "default": "Classic",
          "description": "Color palette applied to MCNP syntax tokens (comments, keywords, surfaces, materials, tallies, numbers, ZAIDs). Applied live via editor.tokenColorCustomizations."
        },
        "owen.highlight.openmc.palette": {
          "type": "string",
          "enum": [
            "Classic",
            "Solarized",
            "High Contrast",
            "Pastel",
            "Custom"
          ],
          "enumDescriptions": [
            "VS Code dark default-style colors",
            "Muted Solarized-inspired accents",
            "Bright, vivid, maximum legibility",
            "Soft low-saturation tones",
            "Your own colors - edit owen.highlight.customColors"
          ],
          "default": "Classic",
          "description": "Color palette applied to OpenMC API tokens inside Python files (openmc module, classes, functions, submodules). Applied as editor decorations, and via an injection grammar plus editor.tokenColorCustomizations where no Python language server is active."
        },
        "owen.highlight.customColors": {
          "type": "object",
          "default": {},
          "markdownDescription": "Colors for the **Custom** highlight palette, per token role. Select `Custom` in any `owen.highlight.<language>.palette` setting (or via `OWEN: Choose Highlight Palette`) to use these. Each role takes a hex color string (`\"keyword\": \"#FF9100\"`) or an object with a font style (`\"comment\": { \"foreground\": \"#6A9955\", \"fontStyle\": \"italic\" }`). Roles you leave out fall back to the Classic color. Roles: `comment` `keyword` `type` (classes, surface types) `entity` (submodules, macrobodies, materials) `func` (functions, tallies) `number` `string` `special` (ZAIDs, libraries) `identifier` (cell/surface ids) `modifier` (particle designators, geometry operators).",
          "properties": {
            "comment": {
              "description": "Comments (hex color or {foreground, fontStyle})"
            },
            "keyword": {
              "description": "Keywords / the openmc module name"
            },
            "type": {
              "description": "Classes, surface types, material ids"
            },
            "entity": {
              "description": "Submodules, macrobodies, material names"
            },
            "func": {
              "description": "Functions, tallies, MT cards"
            },
            "number": {
              "description": "Numeric literals"
            },
            "string": {
              "description": "Quoted strings"
            },
            "special": {
              "description": "ZAIDs and library identifiers"
            },
            "identifier": {
              "description": "Cell and surface ids"
            },
            "modifier": {
              "description": "Particle designators, geometry operators"
            }
          }
        },
        "owen.highlight.openmc.decorate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Draw the OpenMC palette as editor decorations in Python files that import `openmc`.\n\nThis is on because a Python language server (Pylance) publishes semantic tokens, and VS Code colors a semantic token from the scopes its *type* maps to — so `openmc.Material` is colored as a generic `class` and OWEN's injection grammar never gets a say. Decorations draw above that layer. Turn this off to leave OpenMC files entirely to the Python extension."
        },
        "owen.highlight.openmc.coverage": {
          "type": "string",
          "enum": [
            "Full deck",
            "OpenMC API only"
          ],
          "enumDescriptions": [
            "Also color comments, strings, numbers, keywords and def/class names",
            "Color only OpenMC API names, leaving the rest to your theme"
          ],
          "default": "Full deck",
          "markdownDescription": "How much of an OpenMC deck the palette colors.\n\n`Full deck` also claims Python comments, strings, numeric literals, keywords (`def`, `import`, `for`) and the name a `def`/`class` introduces. OpenMC API names are a small minority of the characters in a real deck, so with `OpenMC API only` the palettes recolor very little and look nearly identical to one another. Plain variable names are never claimed under either setting — themes leave those in the default foreground.\n\nApplies only to files detected as OpenMC decks; ordinary Python is untouched. Requires `#owen.highlight.openmc.decorate#`."
        },
        "owen.highlight.serpent.palette": {
          "type": "string",
          "enum": [
            "Classic",
            "Solarized",
            "High Contrast",
            "Pastel",
            "Custom"
          ],
          "enumDescriptions": [
            "VS Code dark default-style colors",
            "Muted Solarized-inspired accents",
            "Bright, vivid, maximum legibility",
            "Soft low-saturation tones",
            "Your own colors - edit owen.highlight.customColors"
          ],
          "default": "Classic",
          "description": "Color palette applied to Serpent syntax tokens (comments, keywords, materials, cells/pins/surfaces, numbers, strings, ZAIDs). Applied live via editor.tokenColorCustomizations."
        },
        "owen.highlight.scone.palette": {
          "type": "string",
          "enum": [
            "Classic",
            "Solarized",
            "High Contrast",
            "Pastel",
            "Custom"
          ],
          "enumDescriptions": [
            "VS Code dark default-style colors",
            "Muted Solarized-inspired accents",
            "Bright, vivid, maximum legibility",
            "Soft low-saturation tones",
            "Your own colors - edit owen.highlight.customColors"
          ],
          "default": "Classic",
          "description": "Color palette applied to SCONE syntax tokens (comments, keywords, block/section names, numbers, strings). Applied live via editor.tokenColorCustomizations."
        }
      }
    },
    "snippets": [
      {
        "language": "mcnp",
        "path": "./snippets/mcnp.json"
      },
      {
        "language": "python",
        "path": "./snippets/openmc.json"
      },
      {
        "language": "serpent",
        "path": "./snippets/serpent.json"
      },
      {
        "language": "scone",
        "path": "./snippets/scone.json"
      },
      {
        "language": "phits",
        "path": "./snippets/phits.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.js --production",
