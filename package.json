  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "pretest": "tsc -p .",
    "test": "node ./out/src/test/runTest.js",
    "verify:mcnp-rules": "node ./scripts/verify-mcnp-rules.mjs",
    "verify:openmc-tokens": "node ./scripts/verify-openmc-tokens.mjs",
    "verify:openmc-native": "tsc -p . && node ./scripts/verify-openmc-native.mjs",
    "verify:results": "tsc -p . && node ./scripts/verify-results.mjs",
    "verify:h5-bundle": "node ./scripts/verify-h5-bundle.mjs",
    "verify:run": "tsc -p . && node ./scripts/verify-run.mjs",
    "verify:converter": "tsc -p . && node ./scripts/verify-converter.mjs",
    "package": "vsce package",
    "publish": "vsce publish",
    "export-nrdp": "node ./scripts/export-nrdp-snapshot.mjs",
    "sync-nrdp-cards": "node ./scripts/sync-nrdp-cards.mjs",
    "export-tutorials": "node ./scripts/export-tutorial-links.mjs && node ./scripts/export-search-index.mjs"
  },
